{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Rust: check release",
      "type": "shell",
      "command": "source \"$HOME/export-esp.sh\" && cargo --config .cargo/esp32-ci.toml check --release --target xtensa-esp32s3-none-elf --features firmware --locked",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build"
    },
    {
      "label": "Rust: build release",
      "type": "shell",
      "command": "source \"$HOME/export-esp.sh\" && cargo --config .cargo/esp32-ci.toml build --release --target xtensa-esp32s3-none-elf --features firmware --locked",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build"
    },
    {
      "label": "Rust: clean",
      "type": "shell",
      "command": "cargo clean",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "ESPFlash: monitor",
      "type": "shell",
      "command": "espflash monitor",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}

