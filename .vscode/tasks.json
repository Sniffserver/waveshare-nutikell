{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Rust: check release",
      "type": "shell",
      "command": "cargo check --release",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build"
    },
    {
      "label": "Rust: build release",
      "type": "shell",
      "command": "cargo build --release",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build"
    },
    {
      "label": "Rust: clean",
      "type": "shell",
      "command": "cargo clean",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "ESPFlash: monitor",
      "type": "shell",
      "command": "espflash monitor",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}

